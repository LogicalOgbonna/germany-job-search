# Run npm run setup to create workspace-specific localhost settings.
DATABASE_URL=postgresql://jobdesk:local-jobdesk@127.0.0.1:55011/jobdesk
REDIS_URL=redis://127.0.0.1:55012
JOBDESK_DB_PORT=55011
JOBDESK_REDIS_PORT=55012
COMPOSE_PROJECT_NAME=jobdesk-local
# Optional HTTP Basic password. Username is arinze. Required for non-local access.
DASHBOARD_PASSWORD=
# Optional Chrome path; Puppeteer's bundled Chromium is the default.
CHROME_EXECUTABLE_PATH=
# Mail updates (optional). OAuth client of type "Desktop app" with the Gmail API enabled; then run npm run mail:connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Second reader for mail. Without it only receipts are filed automatically; outcome mail waits in Needs review.
ANTHROPIC_API_KEY=
MAIL_AI_MODEL=claude-sonnet-5-5
# Set to off to stop Claude confirming outcome emails; they then wait in Needs review.
MAIL_SECOND_OPINION=on
# Interview preparation (uses ANTHROPIC_API_KEY). Practice falls back to the prep model.
PREP_AI_MODEL=claude-opus-5-5
PRACTICE_AI_MODEL=

# LinkedIn "JobDesk" app (Share on LinkedIn + Sign In with OpenID Connect). Redirect URL must match the app's Auth tab.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:53682/callback
# LinkedIn "JobDesk Data" app (Member Data Portability API (Member)), read-only.
LINKEDIN_DATA_CLIENT_ID=
LINKEDIN_DATA_CLIENT_SECRET=
LINKEDIN_DATA_REDIRECT_URI=http://127.0.0.1:53683/callback
